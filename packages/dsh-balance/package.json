{
  "name": "dsh-balance-quota",
  "version": "0.3.3",
  "description": "DeepSeek Harness Web plugin for secure provider balance, quota, and model health monitoring",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md",
    "docs",
    "package.json"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "balance",
    "quota",
    "provider",
    "health-monitoring",
    "status"
  ],
  "license": "MIT",
  "author": "kongshan-zhuyu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kongshan-zhuyu/dsh-balance-quota.git"
  },
  "bugs": {
    "url": "https://github.com/kongshan-zhuyu/dsh-balance-quota/issues"
  },
  "homepage": "https://github.com/kongshan-zhuyu/dsh-balance-quota#readme",
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.7"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  }
}
